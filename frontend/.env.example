# Leave empty in development: Vite proxies /api to VITE_DEV_API_PROXY (default http://localhost:8000).
# In production set the public API origin, e.g. https://api.thermaltrace.example.org
VITE_API_BASE_URL=
VITE_DEV_API_PROXY=http://localhost:8000
# Optional custom basemap styles (MapLibre style JSON URLs). Defaults: CARTO Positron / Dark Matter (no key).
VITE_MAP_STYLE_LIGHT=
VITE_MAP_STYLE_DARK=
# Optional CARTO basemaps API key (https://carto.com/basemaps/apikey/). PUBLIC: compiled into the bundle and sent with
# every tile request; restrict it to your web origins in the CARTO dashboard. Never put a server secret in a VITE_ variable.
VITE_CARTO_API_KEY=
# [OPTIONAL, PUBLIC] Set to off to hide the facility satellite view's imagery (EOX Sentinel-2 cloudless, CC BY-NC-SA 4.0,
# non-commercial). Empty = on. No key: the browser fetches public tiles. PUBLIC setting, compiled into the bundle.
VITE_SATELLITE_IMAGERY=
