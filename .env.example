# ThermalTrace configuration. Copy to .env and fill in. NEVER commit a real .env.
# Legend: [REQUIRED] must be set · [OPTIONAL] degrades gracefully when blank · [PROVIDER] enables one integration.

# --- runtime ---------------------------------------------------------------------------------
ENVIRONMENT=development                # [REQUIRED] development | staging | production | test
LOG_LEVEL=INFO                         # [OPTIONAL]
LOG_JSON=false                         # [OPTIONAL] true in production (structured logs)
DEMO_MODE=false                        # [OPTIONAL] true only for offline demos; refused in production

# --- database (PostgreSQL 16 + PostGIS 3.4) ----------------------------------------------------
POSTGRES_USER=thermaltrace             # docker-compose only
POSTGRES_PASSWORD=PLACEHOLDER_REQUIRED # docker-compose only
POSTGRES_DB=thermaltrace               # docker-compose only
DATABASE_URL=postgresql+psycopg://thermaltrace:PLACEHOLDER_REQUIRED@localhost:5432/thermaltrace  # [REQUIRED]

# --- security ----------------------------------------------------------------------------------
# [REQUIRED outside development] >= 32 random chars, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=PLACEHOLDER_REQUIRED
ACCESS_TOKEN_TTL_MINUTES=480           # [OPTIONAL]
CORS_ORIGINS=http://localhost:5173     # [REQUIRED] comma-separated web origins
RATE_LIMIT_PER_MINUTE=600              # [OPTIONAL] per session token; per IP for anonymous requests
LOGIN_RATE_LIMIT_PER_MINUTE=10         # [OPTIONAL]
# [OPTIONAL] Events last detected longer ago than this never raise alerts (a history backfill must not notify)
ALERT_MAX_EVENT_AGE_HOURS=72
# [OPTIONAL] Guided read-only 'Explore as Analyst / Admin' on the login page, no credentials. Enable for public demos or judging.
EXPLORE_MODE_ENABLED=false
# [OPTIONAL] Lifetime of an explore (demo) session, minutes
EXPLORE_SESSION_MINUTES=120
# [OPTIONAL] Public landing-page aggregates (totals, source states, 30-day activity on a 1-degree grid; no identifiers)
PUBLIC_LANDING_ENABLED=true

# --- NASA FIRMS ----------------------------------------------------------------------------------
# [PROVIDER] Free key: https://firms.modaps.eosdis.nasa.gov/api/map_key/ - enables historical / Area API.
# Blank = keyless public NRT files only (live polling of all four sensors still works).
FIRMS_MAP_KEY=
FIRMS_REGION_NAME=South_Asia           # [OPTIONAL] FIRMS regional NRT file name
REGION_BBOX=[68.0,6.5,97.5,35.7]       # [OPTIONAL] west,south,east,north region of interest
FIRMS_POLL_MINUTES=30                  # [OPTIONAL]

# --- OpenStreetMap -------------------------------------------------------------------------------
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter  # [OPTIONAL] self-host for volume
HTTP_USER_AGENT=ThermalTrace/1.0 (+https://github.com/saad-46/ThermalTrace)                  # [OPTIONAL] identify your deployment

# --- Copernicus / Sentinel-2 ----------------------------------------------------------------------
# [PROVIDER] CDSE OAuth client - enables SWIR renders around events
COPERNICUS_CLIENT_ID=
# [PROVIDER]
COPERNICUS_CLIENT_SECRET=
SATELLITE_MAX_CLOUD=60                 # [OPTIONAL] cloud % threshold for scene search (Earth Search is keyless)

# --- facility registries (file import; no keys) ----------------------------------------------------
DATASETS_DIR=./data/datasets           # [OPTIONAL] where GEM / CEA release files are placed for import

# --- delivery ----------------------------------------------------------------------------------------
# [PROVIDER] email alerts; blank = email deliveries recorded as "skipped"
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# [PROVIDER] Web Push; generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.org

# --- observability -----------------------------------------------------------------------------------
# [OPTIONAL]
SENTRY_DSN=

# --- web app (build time) ------------------------------------------------------------------------------
# [REQUIRED in production] public API origin; blank in dev (Vite proxy)
VITE_API_BASE_URL=
# [OPTIONAL] MapLibre style URL; default CARTO Positron (no key)
VITE_MAP_STYLE_LIGHT=
# [OPTIONAL]
VITE_MAP_STYLE_DARK=
# [OPTIONAL, PUBLIC] CARTO basemaps API key (https://carto.com/basemaps/apikey/). Compiled into the web bundle and sent
# with every tile request, so treat it as public: restrict it to your web origins in the CARTO dashboard.
VITE_CARTO_API_KEY=

# --- advanced tuning (optional) ------------------------------------------------------------------------
# Defaults (from backend/app/core/config.py) apply while these stay commented. Change only with a reason.
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=10
# CLUSTER_RADIUS_M=1500              # event clustering: max distance between detections of one event
# CLUSTER_GAP_DAYS=5                 # event clustering: max gap before a new event starts
# ATTRIBUTION_RADIUS_M=10000         # facility search radius around an event
# REGION_COUNTRY_ISO3=IND
# OVERPASS_MIN_INTERVAL_S=2.0        # politeness delay between Overpass requests
# OSM_CACHE_TTL_HOURS=168
# REPORT_STORAGE_DIR=backend/var/reports
# MODEL_DIR=backend/var/models
# Provider endpoints (override only for a mirror or a proxy):
# FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov
# EARTH_SEARCH_URL=https://earth-search.aws.element84.com/v1
# CDSE_STAC_URL=https://stac.dataspace.copernicus.eu/v1
# OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
# OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
# NOMINATIM_URL=https://nominatim.openstreetmap.org
